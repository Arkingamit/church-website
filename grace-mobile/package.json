{
  "name": "grace-mobile",
  "version": "1.0.0",
  "description": "Grace Community Church - React Native/Expo App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
