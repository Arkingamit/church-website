# Database Connection
# You can get a MongoDB connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/grace_connect?retryWrites=true&w=majority

# Authentication
# Used to sign JWT session cookies
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Google OAuth
# Used for Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
